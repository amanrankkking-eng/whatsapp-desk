# Copy to .env and fill in. ./scripts/setup.sh does this for you and generates the secrets.

# The domain people open the dashboard on. Its DNS A record must point at this server.
DESK_DOMAIN=desk.example.com

# Dashboard login.
DESK_USER=admin
DESK_PASSWORD=

# Internal secrets. Generate each with:  openssl rand -hex 24
POSTGRES_PASSWORD=
EVO_API_KEY=

# 1 = the login cookie only travels over HTTPS (keep 1 with a domain).
COOKIE_SECURE=1
